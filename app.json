{
  "expo": {
    "scheme": "swiprapp",
    "name": "SWIPR_APP",
    "slug": "swipr_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Allow access to select a profile photo." }]
    ]
  }
}